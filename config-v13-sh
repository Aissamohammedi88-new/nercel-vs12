def agent_create(p):
    name = (p.get("name") or "").strip() or "agent-sans-nom"
    goal = (p.get("goal") or "").strip()
    if not goal:
        return None, "objectif (goal) requis"
    slug = slugify(name)
    with LOCK:
        if any(a["slug"] == slug for a in AGENTS.values()):
            slug = slug + "-" + uuid.uuid4().hex[:4]
        aid = uuid.uuid4().hex[:8]
        built = ollama_commands(p.get("prompt"), goal) if p.get("use_ollama") else None
        if built is None:
            built = {"run": compile_prompt(p.get("prompt") or goal), "source": "prompt-rules"}
        if not cmd_is_safe(built["run"]):
            return None, "commande refusee (mot interdit)"
        a = {"id": aid, "slug": slug, "name": name, "goal": goal,
             "cmd": built["run"], "source": built["source"],
             "interval": max(0, int(p.get("interval") or 0)),
             "created": time.time(), "runs": 0, "last_status": "jamais",
             "last_exit": None, "last_ts": None, "status": "idle"}
        AGENTS[aid] = a
    log("hub", "ok", "agent cree: %s (%s) cmd=%s" % (name, aid, built["run"][:80]))
    return a, None

def run_agent(aid):
    with LOCK:
        a = AGENTS.get(aid)
    if not a:
        return None, "agent inconnu"
    run = {"id": uuid.uuid4().hex[:8], "agent_id": aid, "agent": a["slug"],
           "ts": time.time(), "status": "running", "exit": None, "pid": None}
    with LOCK:
        RUNS.appendleft(run)
        a["status"] = "running"
        a["runs"] += 1
    threading.Thread(target=_worker, args=(dict(a), run), daemon=True).start()
    return run, None

def _worker(a, run):
    n = 0
    code = -1
    proc = None
    log(a["slug"], "sys", "$ " + a["cmd"])
    try:
        proc = subprocess.Popen(a["cmd"], shell=True, cwd=HOME,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, bufsize=1)
        run["pid"] = proc.pid
        log(a["slug"], "info", "pid %d demarre - la sortie arrive en direct" % proc.pid)
        t0 = time.time()
        for line in proc.stdout:
            line = line.rstrip()
            if line:
                log(a["slug"], "out", line)
                n += 1
            if time.time() - t0 > 170:
                proc.kill()
                log(a["slug"], "warn", "cap 170s - processus tue")
                break
        code = proc.wait(timeout=15)
    except Exception as e:
        code = -1
        log(a["slug"], "err", "erreur worker: %s" % e)
        try:
            if proc:
                proc.kill()
        except Exception:
            pass
    run["exit"] = code
    run["status"] = "ok" if code == 0 else "error"
    with LOCK:
        cur = AGENTS.get(a["id"])
        if cur:
            cur["status"] = "idle"
            cur["last_status"] = run["status"]
            cur["last_exit"] = code
            cur["last_ts"] = time.time()
    log(a["slug"], "ok" if code == 0 else "err",
        "run %s fini - exit=%s, %d lignes de log" % (run["id"], code, n))

