def compile_prompt(text):
    t = (text or "").lower()
    for keys, cmd in PROMPT_RULES:
        if any(k in t for k in keys):
            return cmd
    safe = re.sub(r"[^A-Za-z0-9 ]", "", (text or "veille"))[:60]
    return 'bash -lc "echo [tache] %s; date; uptime"' % safe

def ollama_models():
    try:
        r = urlreq.urlopen(OLLAMA + "/api/tags", timeout=2)
        j = json.loads(r.read().decode("utf-8"))
        return [m.get("name", "") for m in j.get("models", []) if m.get("name")]
    except Exception:
        return []

OLLAMA_STATE = {"up": False, "model": None, "checked": 0.0}

def ollama_state(force=False):
    now = time.time()
    if not force and now - OLLAMA_STATE["checked"] < 30:
        return OLLAMA_STATE["up"], OLLAMA_STATE["model"]
    models = ollama_models()
    OLLAMA_STATE.update(up=bool(models), model=models[0] if models else None, checked=now)
    return OLLAMA_STATE["up"], OLLAMA_STATE["model"]

def ollama_commands(prompt, goal):
    try:
        models = ollama_models()
        if not models:
            return None
        q = ('Tu generes UNE commande bash Linux, courte et sure, qui realise: "%s". '
             'Reponds UNIQUEMENT par la commande, sans explication, sans backticks.'
             % (prompt or goal or "etat systeme"))[:600]
        data = json.dumps({"model": models[0], "prompt": q, "stream": False}).encode("utf-8")
        req = urlreq.Request(OLLAMA + "/api/generate", data=data,
                             headers={"Content-Type": "application/json"})
        r = urlreq.urlopen(req, timeout=90)
        cmd = json.loads(r.read().decode("utf-8")).get("response", "").strip()
        cmd = cmd.strip("`").strip()
        if not cmd or "\n" in cmd or not cmd_is_safe(cmd):
            return None
        return {"run": cmd, "source": "ollama:" + models[0]}
    except Exception:
        return None

