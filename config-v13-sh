class H(BaseHTTPRequestHandler):
    server_version = "Nercel14"

    def log_message(self, fmt, *args):
        pass

    def _json(self, obj, code=200):
        try:
            body = json.dumps(obj, ensure_ascii=False, default=str).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)
        except Exception:
            pass

    def _page(self):
        body = PAGE.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except Exception:
            n = 0
        raw = self.rfile.read(n) if n > 0 else b"{}"
        try:
            return json.loads(raw.decode("utf-8") or "{}")
        except Exception:
            return {}

    def do_GET(self):
        u = urlparse(self.path)
        q = parse_qs(u.query)
        p = u.path
        try:
            if p == "/":
                return self._page()
            if p == "/api/health":
                with LOCK:
                    return self._json({"ok": True, "version": VERSION,
                                       "uptime_s": int(time.time() - START_TS),
                                       "agents": len(AGENTS), "runs": len(RUNS),
                                       "logs": LOG_SEQ, "chat": len(CHAT)})
            if p == "/api/state":
                with LOCK:
                    series = {k: [list(x) for x in v] for k, v in SERIES.items()}
                    ags = [dict(a) for a in AGENTS.values()]
                    rns = list(RUNS)[:60]
                up, model = ollama_state()
                return self._json({"metrics": metrics_snapshot(), "series": series,
                                   "agents": ags, "runs": rns, "ollama": up,
                                   "model": model, "uptime_s": int(time.time() - START_TS),
                                   "version": VERSION})
            if p == "/api/logs":
                try:
                    after = int((q.get("after") or ["0"])[0] or 0)
                except Exception:
                    after = 0
                agent = (q.get("agent") or [""])[0]
                with LOCK:
                    lines = [l for l in LOG_FEED
                             if l["seq"] > after and (not agent or l["agent"] == agent)]
                return self._json({"seq": LOG_SEQ, "lines": lines[-600:]})
            if p == "/api/catalog":
                return self._json({"catalog": OSS_CATALOG})
            if p == "/api/scaffolds":
                out = []
                if os.path.isdir(SCAFFOLD_ROOT):
                    for d in sorted(os.listdir(SCAFFOLD_ROOT)):
                        fp = os.path.join(SCAFFOLD_ROOT, d)
                        if os.path.isdir(fp):
                            out.append({"slug": d, "path": fp,
                                        "files": sorted(f for f in os.listdir(fp)
                                                        if os.path.isfile(os.path.join(fp, f)))})
                bps = {k: {"label": v["label"], "desc": v["desc"], "run": v["cmd"]}
                       for k, v in BLUEPRINTS.items()}
                return self._json({"scaffolds": out, "blueprints": bps})
            if p == "/api/chat":
                with LOCK:
                    ch = list(CHAT)[-150:]
                up, model = ollama_state()
                return self._json({"chat": ch, "ollama": up, "model": model})
            return self._json({"error": "route inconnue: %s" % p}, 404)
        except Exception as e:
            return self._json({"error": "exception serveur: %s" % e}, 500)

    def do_POST(self):
        u = urlparse(self.path)
        parts = [s for s in u.path.split("/") if s]
        p = self._body()
        try:
            if u.path == "/api/agents/create":
                a, err = agent_create(p)
                return self._json({"error": err} if err else {"agent": a}, 400 if err else 200)
            if u.path == "/api/agents/recommend":
                return self._json({"goal": p.get("goal"),
                                   "recommend": recommend(p.get("goal"))})
            if u.path == "/api/chat":
                r, err = chat_post(p)
                return self._json({"error": err} if err else r, 400 if err else 200)
            if u.path == "/api/ollama/check":
                up, model = ollama_state(force=True)
                return self._json({"ollama": up, "model": model})
            if u.path == "/api/scaffolds/create":
                r, err = scaffold_create(p)
                return self._json({"error": err} if err else {"scaffold": r}, 400 if err else 200)
            if len(parts) == 4 and parts[0] == "api" and parts[1] == "agents":
                aid = parts[2]
                if parts[3] == "run":
                    r, err = run_agent(aid)
                    return self._json({"error": err} if err else {"run": r}, 400 if err else 200)
                if parts[3] == "delete":
                    with LOCK:
                        a = AGENTS.pop(aid, None)
                    if not a:
                        return self._json({"error": "agent inconnu"}, 404)
                    log("hub", "warn", "agent supprime: " + a["slug"])
                    return self._json({"ok": True})
                if parts[3] == "update":
                    with LOCK:
                        a = AGENTS.get(aid)
                        if not a:
                            return self._json({"error": "agent inconnu"}, 404)
                        if "interval" in p:
                            a["interval"] = max(0, int(p["interval"] or 0))
                        if p.get("goal"):
                            a["goal"] = p["goal"]
                    return self._json({"agent": a})
            return self._json({"error": "route POST inconnue: %s" % u.path}, 404)
        except Exception as e:
            return self._json({"error": "exception serveur: %s" % e}, 500)

def main():
    os.makedirs(SCAFFOLD_ROOT, exist_ok=True)
    seed()
    threading.Thread(target=sampler, daemon=True).start()
    threading.Thread(target=scheduler, daemon=True).start()
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), H)
    srv.daemon_threads = True
    print("NERCEL 14 HUB -> http://localhost:%d  (Ctrl+C pour arreter)" % PORT)
    srv.serve_forever()

if __name__ == "__main__":
    main()
