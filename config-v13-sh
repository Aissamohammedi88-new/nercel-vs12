                 f"Etat reel machine: CPU {ms['cpu']:.0f}%, RAM {ms['ram']:.0f}%, disque {ms['disk']:.0f}%.")
        try:
            data = json.dumps({"model": models[0], "prompt": msg,
                               "system": sys_p, "stream": False}).encode("utf-8")
            req = urlreq.Request(OLLAMA + "/api/generate", data=data,
                                 headers={"Content-Type": "application/json"})
            r = urlreq.urlopen(req, timeout=90)
            reply = json.loads(r.read().decode("utf-8")).get("response", "").strip() or None
            if reply:
                engine_used = "ollama:" + models[0]
                log("chat", "ok", "ollama(%s) a repondu (%d car)" % (models[0], len(reply)))
        except Exception as e:
            log("chat", "warn", "ollama KO: %s - bascule moteur interne" % e)
            reply = None
    if not reply:
        reply = engine_reply(msg, agent)
    with LOCK:
        CHAT.append({"role": "agent", "agent": a_slug, "text": reply, "ts": time.time()})
    log("chat", "chat", "hub: " + reply[:120].replace("\n", " | "))
    return {"reply": reply, "engine": engine_used}, None

def cpu_jiffies():
    with open("/proc/stat") as f:
        p = f.readline().split()[1:]
    return list(map(int, p[:8]))

def sampler():
    global NET_PREV
    prev = cpu_jiffies()
    with open("/proc/net/dev") as f:
        NET_PREV = sum(int(l.split()[1]) for l in f.readlines()[2:]
                       if not l.split()[0].rstrip(":").startswith("lo"))
    time.sleep(5)
    while True:
        try:
            cur = cpu_jiffies()
            idle = (cur[3] + cur[4]) - (prev[3] + prev[4])
            tot = sum(cur) - sum(prev)
            cpu = 100.0 * (1 - idle / tot) if tot else 0.0
            prev = cur
            mem = {}
            with open("/proc/meminfo") as f:
                for l in f:
                    k = l.split(":")
                    if k[0] in ("MemTotal", "MemAvailable"):
                        mem[k[0]] = int(k[1].split()[0])
            ram = 100.0 * (1 - mem.get("MemAvailable", 0) / max(1, mem.get("MemTotal", 1)))
            with open("/proc/net/dev") as f:
                net_now = sum(int(l.split()[1]) for l in f.readlines()[2:]
                              if not l.split()[0].rstrip(":").startswith("lo"))
            rate = max(0, net_now - (NET_PREV or net_now)) / 5.0
            NET_PREV = net_now
            du = shutil.disk_usage(HOME)
            load = os.getloadavg()[0]
            ts = time.time()
            with LOCK:
                SERIES["cpu"].append((ts, round(cpu, 1)))
                SERIES["ram"].append((ts, round(ram, 1)))
                SERIES["net"].append((ts, int(rate)))
                SERIES["disk"].append((ts, round(100 * du.used / du.total, 1)))
                SERIES["load"].append((ts, round(load, 2)))
        except Exception as e:
            log("hub", "warn", "sampler: %s" % e)
        time.sleep(5)

def scheduler():
    while True:
        time.sleep(10)
        now = time.time()
        with LOCK:
            agents = list(AGENTS.values())
        for a in agents:
            if a["interval"] > 0 and a["status"] == "idle":
                if not a["last_ts"] or now - a["last_ts"] >= a["interval"]:
                    log("hub", "info", "scheduler: lance %s (interval=%ss)" % (a["slug"], a["interval"]))
                    run_agent(a["id"])

def seed():
    if not AGENTS:
        agent_create({"name": "Sentinelle CPU", "goal": "surveiller le cpu et la charge systeme", "interval": 60})
        agent_create({"name": "Gardien Disque", "goal": "surveiller l espace disque et les gros fichiers", "interval": 300})
    log("hub", "ok", "NERCEL %s HUB demarre - port %d - theme grafana v10 restaure" % (VERSION, PORT))

