function draw(el, data, color, cap){
  if (!el) return;
  const dpr = window.devicePixelRatio || 1;
  const w = el.clientWidth, hg = el.clientHeight;
  if (!w) return;
  el.width = w*dpr; el.height = hg*dpr;
  const c = el.getContext('2d'); c.scale(dpr, dpr);
  c.clearRect(0,0,w,hg);
  if (!data || !data.length) return;
  const vals = data.map(p=>p[1]);
  let max = Math.max(...vals, 1);
  if (cap) max = Math.max(cap, max);
  c.strokeStyle = '#2c3235'; c.beginPath(); c.moveTo(0, hg-0.5); c.lineTo(w, hg-0.5); c.stroke();
  c.strokeStyle = color; c.lineWidth = 1.6; c.beginPath();
  vals.forEach((v,i)=>{ const x = i/(vals.length-1||1)*w; const y = hg-4-(Math.min(v,max)/max)*(hg-8); i?c.lineTo(x,y):c.moveTo(x,y); });
  c.stroke();
}
