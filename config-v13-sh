def scaffold_create(p):
    name = (p.get("name") or "").strip()
    bp = p.get("blueprint") or "py-cli"
    if bp not in BLUEPRINTS:
        return None, "blueprint inconnu: %s" % bp
    slug = slugify(name) if name else bp + "-" + uuid.uuid4().hex[:4]
    target = os.path.join(SCAFFOLD_ROOT, slug)
    if os.path.exists(target):
        return None, "le dossier existe deja: " + target
    b = BLUEPRINTS[bp]
    os.makedirs(target)
    made = []
    for fname, content in b["files"].items():
        fp = os.path.join(target, fname)
        d = os.path.dirname(fp)
        if d and not os.path.isdir(d):
            os.makedirs(d)
        with open(fp, "w") as f:
            f.write(content)
        if fname.endswith(".py"):
            os.chmod(fp, 0o755)
        made.append(os.path.relpath(fp, HOME))
        log("scaffold", "info", "ecrit " + os.path.relpath(fp, HOME))
    log("scaffold", "ok", "scaffold %s cree (%d fichiers) - %s" % (slug, len(made), target))
    return {"slug": slug, "path": target, "files": made, "blueprint": bp, "run": b["cmd"]}, None

