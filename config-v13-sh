def recommend(goal):
    words = [w for w in re.split(r"[^a-zA-Z0-9]+", (goal or "").lower())
             if len(w) > 2 and w not in STOP]
    scored = []
    for c in OSS_CATALOG:
        score = 0
        hits = []
        tags = [t.lower() for t in c["tags"]]
        for w in words:
            if w in tags:
                score += 4
                hits.append(w)
            elif w in c["desc"].lower() or w in c["name"].lower():
                score += 1
                hits.append(w)
        if score:
            scored.append((score, c, hits))
    scored.sort(key=lambda x: -x[0])
    return [{"name": c["name"], "url": c["url"], "desc": c["desc"],
             "install": c["install"], "score": s, "matched": h} for s, c, h in scored[:4]]

