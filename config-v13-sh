def slugify(s):
    s = re.sub(r"[^a-zA-Z0-9]+", "-", (s or "").lower()).strip("-")
    return s or "agent"

def cmd_is_safe(cmd):
    low = " ".join((cmd or "").lower().split())
    return not any(f in low for f in FORBIDDEN)

