    const f = $('logFilter').value;
    const j = await api('/api/logs?after='+LOG_AFTER+(f?'&agent='+encodeURIComponent(f):''));
    if (j.lines.length){
      for (const l of j.lines){
        const t = new Date(l.ts*1000).toLocaleTimeString('fr-FR');
        const line = t+'  ['+l.level.toUpperCase()+'] '+l.agent.padEnd(10)+' '+l.text+'\\n';
        appendTerm($('logTerm'), line, 'lv-'+l.level);
        appendTerm($('miniLog'), line, 'lv-'+l.level);
      }
      LOG_AFTER = j.seq; LOG_LINES += j.lines.length;
      $('logCount').textContent = LOG_LINES+' lignes';
      $('logTerm').scrollTop = $('logTerm').scrollHeight;
      $('miniLog').scrollTop = $('miniLog').scrollHeight;
    }
  } catch(e){}
}
